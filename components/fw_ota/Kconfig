menu "Firmware OTA (GitHub main)"

    config FW_OTA_ENABLED
        bool "Enable firmware OTA from GitHub Releases"
        default y
        help
            Portal System tab can check/install updates published from the
            main branch (rolling GitHub release tag "ota").

    config FW_OTA_MANIFEST_URL
        string "OTA manifest URL"
        depends on FW_OTA_ENABLED
        default "https://github.com/ha0rex/esp32-icc1-zigbee-gw/releases/download/ota/manifest.json"
        help
            HTTPS JSON with version + firmware URL. CI on main refreshes the
            rolling "ota" release assets.

endmenu
