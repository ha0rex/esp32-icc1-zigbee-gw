# Shared defaults for ESP32-C3 and ESP32-S3 (target-specific pins in
# sdkconfig.defaults.esp32c3 / sdkconfig.defaults.esp32s3).
# Select with: idf.py set-target esp32c3 | esp32s3

# Console / logging
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_MAXIMUM_LEVEL=5

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
# Wi‑Fi + portal + Zigbee bring-up on S3 (PSRAM path) needs more than the 3.5 KiB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash / partitions — dual OTA slots (layout fits 4MB; S3 Plus may be 8MB chip)
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# HTTPS OTA (GitHub ota branch via raw.githubusercontent.com)
CONFIG_FW_OTA_ENABLED=y
CONFIG_FW_OTA_MANIFEST_URL="https://raw.githubusercontent.com/ha0rex/esp32-icc1-zigbee-gw/ota/manifest.json"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Prefer smaller cert set + dynamic TLS buffers (helps C3; fine on S3).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Wi-Fi SoftAP support required for provisioning portal
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Catch stack smashes that otherwise show up as opaque "panic" resets.
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# ICC UART (TX/RX GPIOs overridden per target)
CONFIG_ICC_UART_PORT_NUM=1
CONFIG_ICC_UART_BAUD=115200

# SoftAP provisioning (home Wi-Fi via portal / NVS)
CONFIG_WIFI_ENABLED=y
CONFIG_WIFI_AP_SSID_PREFIX="ICC1-Gateway"
CONFIG_WIFI_AP_CHANNEL=1
CONFIG_WIFI_AP_OPEN=y
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""
CONFIG_WIFI_MAX_RETRY=10
CONFIG_WEB_HTTP_PORT=80

# HomeKit (HAP httpd must not collide with portal on :80)
# Bridge homes often have several controllers (iPhone + HomePod/ATV hubs). HAP
# reserves 1 socket for EVENT notifs — 4 open sockets causes LRU session drops
# that show up as accessories flickering "No Response" in the Home app.
CONFIG_HK_ENABLED=y
CONFIG_HK_SETUP_CODE="111-22-333"
CONFIG_HK_SETUP_ID="ICC1"
CONFIG_HAP_HTTP_SERVER_PORT=8118
CONFIG_HAP_HTTP_STACK_SIZE=8192
CONFIG_HAP_HTTP_MAX_OPEN_SOCKETS=4
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_LWIP_MAX_LISTENING_TCP=16
CONFIG_LWIP_MAX_UDP_PCBS=16

# Allow LOCK_TCPIP_CORE from Wi‑Fi health (GARP / gateway ARP). Without this,
# etharp_* from a non-tcpip task races lwIP and can panic-reboot the chip.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y

# ASH / EZSP debug hex dumps
CONFIG_ASH_LOG_HEX_FRAMES=n
CONFIG_EZSP_LOG_HEX_FRAMES=n
